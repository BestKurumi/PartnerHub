# 建议 python3 scripts/demo.py init 自动生成 .env 及独立随机凭据。
# 也可手动复制为 .env 后修改；Windows PowerShell: Copy-Item .env.example .env
# 这里全部是本地开发默认值，不含任何真实凭据。

# ---------- 宿主端口映射 ----------
COMPOSE_PROJECT_NAME=partner-hub
HUB_HTTP_PORT=8080
PLATFORM1_HTTP_PORT=18081
PLATFORM2_HTTP_PORT=18082
UPSTREAM_HTTP_PORT=18083
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
KAFKA_HOST_PORT=29092
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=hub_root_pass
MYSQL_PASSWORD=hub_pass
PLATFORM1_DB_PASSWORD=mock_p1_pass
PLATFORM2_DB_PASSWORD=mock_p2_pass

# ---------- Grafana ----------
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ---------- hub 服务 ----------
HUB_LOG_LEVEL=info
# 固定服务端采集地址；Grafana 为浏览器可访问的看板地址（空时按映射端口生成）。
# HUB_GRAFANA_URL=http://127.0.0.1:3000/d/hub-overview
# 双实例内部诊断令牌，与浏览器 DEMO_TOKEN 分开；部署时修改。
HUB_OPS_TOKEN=local-internal-ops-change-me

# 每实例、每平台独立预算；首发与恢复共用总并发及速率。
# 启动暂停停止该平台发送/恢复领取，不删除已有任务；重启后生效。
# Compose pins hub-1 and hub-2; standalone defaults to hub-local.
DEMO_TOKEN=local-demo-change-me
DEMO_SUBNET=172.30.25.0/24
HUB_IMAGE=partner-hub/mvp:local
HUB_IMAGE_TARGET=runtime
# Go模块代理不可达时可按网络环境启用：
# GO_MODULE_PROXY=https://goproxy.cn,direct
HUB_PLATFORM_A_TOTAL_CONCURRENCY=16
HUB_PLATFORM_A_FIRST_CONCURRENCY=12
HUB_PLATFORM_A_RECOVERY_CONCURRENCY=4
HUB_PLATFORM_A_RATE_PER_SECOND=100
HUB_PLATFORM_A_RATE_BURST=4
HUB_PLATFORM_A_PAUSED=false
HUB_PLATFORM_B_TOTAL_CONCURRENCY=16
HUB_PLATFORM_B_FIRST_CONCURRENCY=12
HUB_PLATFORM_B_RECOVERY_CONCURRENCY=4
HUB_PLATFORM_B_RATE_PER_SECOND=100
HUB_PLATFORM_B_RATE_BURST=4
HUB_PLATFORM_B_PAUSED=false

# Shared archive initial budgets; two instances are the supported maximum.
HUB_MAX_INSTANCES=2
HUB_ARCHIVE_MAX_PENDING=10000
HUB_ARCHIVE_MAX_BYTES=134217728
