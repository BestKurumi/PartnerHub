          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 6
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "接入响应速率与在途",
      "description": "含拒绝及不确定响应；接入响应与平台首发、归档分别计量。",
