    {
      "id": 5,
      "type": "timeseries",
      "title": "首次交付确认时延 P99：按平台及结果",
      "description": "接入→各平台首次尝试结束，包括路由与额度等待。失败/UNKNOWN单列，未结束输入不在直方图；达标结论必须结合完整cohort负载报告。B终点是Broker确认。",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hub-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (platform,outcome,le) (rate(hub_first_delivery_duration_seconds_bucket[5m])))",
          "legendFormat": "{{platform}} {{outcome}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
