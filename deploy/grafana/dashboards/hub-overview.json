  "title": "中台运维 · 运行与依赖",
  "uid": "hub-overview",
  "version": 3,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "中台实例采集健康",
      "description": "1=抓取成功。分别抓取 hub-1/hub-2，避免代理掩盖单实例故障。",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hub-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"hub\"}",
          "legendFormat": "{{job}} {{instance}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 6
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "中台后台采样健康与陈旧时间",
      "description": "健康=0或最后成功时间缺失/过旧时，不应把保留的旧值当实时状态。失败不伪造零积压。",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hub-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hub_observation_up",
          "legendFormat": "hub {{instance}} {{kind}} healthy"
        },
        {
          "refId": "B",
          "expr": "time() - hub_observation_last_success_timestamp_seconds",
          "legendFormat": "hub {{instance}} {{kind}} age(s)"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
