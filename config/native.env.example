# python3 scripts/demo.py native-init 生成 .env.native，然后填写已有依赖。
# Go依赖自动下载、DSN自动生成、启动时自动迁移；不启动任何容器。

# 必填：已有MySQL管理员密码与可访问的中间件地址。
MYSQL_ADDR=127.0.0.1:3306
MYSQL_ROOT_PASSWORD=replace-with-your-existing-root-password
HUB_REDIS_ADDR=127.0.0.1:6379
HUB_REDIS_PASSWORD=
HUB_REDIS_DB=0
HUB_KAFKA_BROKERS=127.0.0.1:9092

# 以下自动生成。首次启动创建三个演示账号；已有账号时填写其对应密码。
MYSQL_PASSWORD=generated-by-native-init
PLATFORM1_DB_PASSWORD=generated-by-native-init
PLATFORM2_DB_PASSWORD=generated-by-native-init
DEMO_TOKEN=generated-by-native-init
HUB_OPS_TOKEN=generated-by-native-init

# 可选：统一页面入口；其他本机应用端口默认28180、28081、28082、28083。
NATIVE_GATEWAY_LISTEN=127.0.0.1:28080
# 可选：未配置观测服务时，运行指标显示未采集。
HUB_PROMETHEUS_URL=
HUB_GRAFANA_URL=
